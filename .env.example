# 默认使用通义千问；深度模型不再默认使用 qwen-max。
AI_PROVIDER=qwen

# Supabase 浏览器端配置。
# SUPABASE_DB_URL 只供 pnpm db:init 使用，不能暴露到客户端或提交真实值。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_URL=

DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_MODEL_FAST=qwen-turbo
QWEN_MODEL_FALLBACK=qwen-turbo

# 切换到 DeepSeek 时，将 AI_PROVIDER 改为 deepseek 并填写密钥。
# 也可以使用 AI_PROVIDER_FAST / AI_PROVIDER_DEEP / AI_PROVIDER_FALLBACK 分层选择服务商。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
DEEPSEEK_MODEL_FALLBACK=deepseek-v4-flash

AI_TWO_PHASE=1
AI_REQUEST_TIMEOUT_MS=45000

# DeepSeek 官方美元价格换算成人民币时使用，可按实际结算汇率调整。
AI_USD_TO_CNY_RATE=7.2

# 可选：覆盖某个模型层级的每百万 Token 人民币价格。
# AI_PRICE_FAST_INPUT_CNY_PER_MILLION=
# AI_PRICE_FAST_CACHED_INPUT_CNY_PER_MILLION=
# AI_PRICE_FAST_OUTPUT_CNY_PER_MILLION=
# AI_PRICE_DEEP_INPUT_CNY_PER_MILLION=
# AI_PRICE_DEEP_CACHED_INPUT_CNY_PER_MILLION=
# AI_PRICE_DEEP_OUTPUT_CNY_PER_MILLION=
